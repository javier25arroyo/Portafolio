---
import WolfMark from "../ui/WolfMark.astro";

const year = new Date().getFullYear();

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#stack", label: "Stack" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];

const socialLinks = [
  {
    href: "https://github.com/javier25arroyo",
    label: "GitHub (nueva pestaña)",
    icon: "github",
  },
  {
    href: "https://www.linkedin.com/in/javier-arroyo-dev",
    label: "LinkedIn (nueva pestaña)",
    icon: "linkedin",
  },
  {
    href: "mailto:javier25arojas@gmail.com",
    label: "Enviar correo",
    icon: "mail",
  },
];
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <WolfMark size={28} />
      <div>
        <p class="footer__name">Javier Pérez Arroyo</p>
        <p class="footer__tagline">Software Engineer full-stack — Costa Rica</p>
      </div>
    </div>

    <nav aria-label="Footer">
      <ul class="footer__nav">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <ul class="footer__social">
      {socialLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-label={link.label}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {link.icon === "github" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
              </svg>
            )}
            {link.icon === "linkedin" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 10v7M7 7v.01M12 17v-4.5a2.5 2.5 0 0 1 5 0V17M12 17v-7" />
              </svg>
            )}
            {link.icon === "mail" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <hr class="hairline container" />

  <div class="container footer__bottom">
    <p>© {year} Javier Pérez Arroyo</p>
    <p class="font-mono">construido con Astro</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-elevated);
    border-top: 1px solid var(--border);
    padding-block: var(--space-12) var(--space-6);
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer__name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
  }

  .footer__tagline {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
  }

  .footer__nav a {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  @media (hover: hover) {
    .footer__nav a:hover {
      color: var(--accent);
    }
  }

  .footer__social {
    display: flex;
    gap: var(--space-4);
    list-style: none;
  }

  .footer__social a {
    color: var(--text-muted);
    display: inline-flex;
  }

  @media (hover: hover) {
    .footer__social a:hover {
      color: var(--accent);
    }
  }

  .footer__bottom {
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--text-subtle);
  }

  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
