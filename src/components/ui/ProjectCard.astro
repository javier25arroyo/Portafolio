---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  category: string;
  year: string;
  image: ImageMetadata;
  imageAlt: string;
  tags: string[];
  href: string;
  featured?: boolean;
}

const {
  title,
  description,
  category,
  year,
  image,
  imageAlt,
  tags,
  href,
  featured = false,
} = Astro.props;

const visibleTags = tags.slice(0, 4);
const extraCount = tags.length - visibleTags.length;
---

<article class="project-card">
  <div class="project-card__thumb">
    <Image src={image} alt={imageAlt} width={640} height={360} loading="lazy" />
  </div>

  <div class="project-card__body">
    <p class="eyebrow eyebrow--muted project-card__meta">
      {featured && <span class="project-card__featured-dot" aria-hidden="true" />}
      {category} · {year}
    </p>

    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__description">{description}</p>

    <ul class="project-card__tags">
      {visibleTags.map((tag) => (
        <li class="project-card__tag">{tag}</li>
      ))}
      {extraCount > 0 && <li class="project-card__tag">+{extraCount}</li>}
    </ul>

    <a class="project-card__link" href={href} target="_blank" rel="noopener noreferrer">
      <span class="project-card__link-text">Ver proyecto <span aria-hidden="true">→</span></span>
      <span class="sr-only"> (nueva pestaña)</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    transition: border-color var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-base) var(--ease-standard),
      transform var(--dur-base) var(--ease-standard);
  }

  @media (hover: hover) {
    .project-card:hover {
      border-color: var(--border-strong);
      box-shadow: var(--shadow-sm);
      transform: translateY(-2px);
    }

    .project-card:hover .project-card__thumb img {
      transform: scale(1.03);
    }
  }

  .project-card__thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .project-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-standard);
  }

  .project-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-card__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .project-card__featured-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--gold);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
  }

  .project-card__description {
    color: var(--text-muted);
    font-size: var(--fs-body);
    line-height: 1.6;
    max-width: 60ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .project-card__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
  }

  .project-card__link {
    position: static;
    color: var(--accent);
    font-weight: 500;
    font-size: var(--fs-body);
    margin-top: auto;
  }

  .project-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  @media (hover: hover) {
    .project-card__link:hover .project-card__link-text {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
