---
/**
 * Marca lobo geométrico. Placeholder de autor propio (SVG line-art) hasta
 * que exista el asset final — ver PRODUCT.md > Brand Commitments.
 * Perfil low-poly de líneas rectas, ojo dorado como único acento.
 */
interface Props {
  size?: number;
  animated?: boolean;
  class?: string;
}

const { size = 48, animated = false, class: className = "" } = Astro.props;
---

<svg
  class:list={["wolf-mark", { "wolf-mark--animated": animated }, className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Marca: lobo geométrico"
>
  <path
    class="wolf-mark__outline"
    pathLength="1"
    d="M8 52 L10 30 L16 8 L20 20 L26 6 L34 16 L46 20 L58 28 L48 34 L36 40 L22 46 Z"
    stroke="var(--accent)"
    stroke-width="2"
    stroke-linejoin="round"
    stroke-linecap="round"
  />
  <path
    class="wolf-mark__facet"
    pathLength="1"
    d="M20 20 L36 40"
    stroke="var(--accent)"
    stroke-width="1.25"
    stroke-linecap="round"
    opacity="0.5"
  />
  <circle class="wolf-mark__eye" cx="40" cy="24" r="1.8" fill="var(--gold)" />
</svg>

<style>
  .wolf-mark__eye {
    transition: opacity var(--dur-slow) var(--ease-standard);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wolf-mark--animated .wolf-mark__outline,
    .wolf-mark--animated .wolf-mark__facet {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: wolf-draw var(--dur-slow) var(--ease-out) forwards;
      animation-duration: 1200ms;
    }

    .wolf-mark--animated .wolf-mark__facet {
      animation-delay: 900ms;
    }

    .wolf-mark--animated .wolf-mark__eye {
      opacity: 0;
      animation: wolf-eye-fade 600ms var(--ease-out) forwards;
      animation-delay: 1300ms;
    }
  }

  @keyframes wolf-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes wolf-eye-fade {
    to {
      opacity: 1;
    }
  }
</style>
